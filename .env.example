# Postgres (Neon in prod, compose.yaml locally). Owner role: runs migrations and ingestion.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_radar

# Shared secret the gateway uses to sign identity headers for private subgraphs.
# Generate: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
INTERNAL_HMAC_SECRET=

# Clerk (injected by the Vercel Marketplace integration in prod)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Subgraph URLs for the gateway (bindings provide these on Vercel)
JOBS_SUBGRAPH_URL=http://localhost:4001/graphql
MATCHING_SUBGRAPH_URL=http://localhost:4002/graphql

# LLM providers. Only PII-redacted text is ever sent (see docs/decisions.md).
GROQ_API_KEY=
GEMINI_API_KEY=
